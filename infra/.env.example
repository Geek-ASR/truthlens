# Copy to backend/.env and fill in real values. Never commit the filled-in file.
ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://truthlens:truthlens@localhost:5432/truthlens
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# AI providers (docs/API_REQUIREMENTS.md)
# LLM_PROVIDER=ollama (default) runs every pipeline stage on local models —
# no key needed, requires `ollama serve` running locally with the models in
# LLM_MODEL_* (see docs/ARCHITECTURE.md §12) pulled. Set LLM_PROVIDER=anthropic
# and fill in ANTHROPIC_API_KEY for higher-quality reasoning instead.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily
TRANSCRIPTION_PROVIDER=openai

# Object storage (MinIO locally; S3/R2 in production)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=truthlens
S3_SECRET_KEY=truthlens-dev-key
S3_BUCKET=truthlens-media
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/truthlens-media

# Meta / Instagram Graph API (docs/API_REQUIREMENTS.md §1 — requires Meta App Review)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
INSTAGRAM_ACCESS_TOKEN=

# Product configuration
MAX_POSTS_PER_DAY=12
HUMAN_APPROVAL_MODE=true
MIN_CONFIDENCE_FOR_AUTO_PUBLISH=0.90
PUBLIC_SITE_BASE_URL=https://truthlens.example
CORS_ORIGINS=["http://localhost:3000"]
