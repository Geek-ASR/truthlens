            "text": "\u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0939\u0915\u094d\u0915\u093e\u0938\u093e\u0920\u0940, \u0928\u094d\u092f\u093e\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0902\u0928\u093e \u0935\u093e\u091a\u093e \u092b\u094b\u0921\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940",
            "grounded": false,
            "source_modalities": []
          },
          {
            "text": "\u0924\u094d\u092f\u093e\u0928\u0947 \u0909\u092d\u093e\u0930\u0932\u0947\u0932\u093e \u0938\u0902\u0918\u0930\u094d\u0937 \u0916\u0930\u094b\u0916\u0930\u091a \u0915\u094c\u0924\u0941\u0915\u093e\u0938\u094d\u092a\u0926 \u0906\u0939\u0947. \u0905\u0936\u093e \u091c\u093f\u0926\u094d\u0926\u0940, \u0905\u092d\u094d\u092f\u093e\u0938\u0942 \u0906\u0923\u093f \u0932\u0922\u093e\u090a \u0924\u0930\u0941\u0923\u093e\u091a\u093e \u092e\u0932\u093e \u092e\u0928\u093e\u092a\u093e\u0938\u0942\u0928",
            "grounded": false,
            "source_modalities": []
          },
          {
            "text": "\u092e\u0932\u093e \u092e\u0928\u092a\u093e\u0938\u0942\u0928 \u0905\u092d\u093f\u092e\u093e\u0928 \u0935\u093e\u091f\u0924\u094b.",
            "grounded": false,
            "source_modalities": []
          },
          {
            "text": "\u0905\u092d\u093f\u091c\u093f\u0924\u0932\u093e \u092a\u0941\u0922\u0940\u0932 \u0935\u093e\u091f\u091a\u093e\u0932\u0940\u0938\u093e\u0920\u0940 \u092e\u0928\u0903\u092a\u0942\u0930\u094d\u0935\u0915 \u0936\u0941\u092d\u0947\u091a\u094d\u091b\u093e\u0964 ",
            "grounded": false,
            "source_modalities": []
          },
          {
            "text": "\u0938\u092e\u093e\u091c\u0939\u093f\u0924 \u0906\u0923\u093f \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0928\u094d\u092f\u093e\u092f\u094d\u092f \u0939\u0915\u094d\u0915\u093e\u0902\u0938\u093e\u0920\u0940 \u0924\u094d\u092f\u093e\u091a\u093e \u0939\u093e \u0932\u0922\u093e \u0905\u0927\u093f\u0915 \u092c\u0933\u0915\u091f",
            "grounded": false,
            "source_modalities": []
          },
          {
            "text": "\u0924\u094d\u092f\u093e\u091a\u093e \u0939\u093e \u0932\u0922\u093e \u0905\u0927\u093f\u0915 \u092c\u0933\u0915\u091f \u0939\u094b\u0924 \u0930\u093e\u0939\u094b, \u0906\u092e\u094d\u0939\u0940 \u0938\u094b\u092c\u0924 \u0906\u0939\u094b\u0924.",
