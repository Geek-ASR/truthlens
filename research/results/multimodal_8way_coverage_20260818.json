            "grounded": false,
            "source_modalities": []
          },
          {
            "text": "\u092e\u0928\u0903\u092a\u0942\u0930\u094d\u0935\u0915 \u0936\u0941\u092d\u0947\u091a\u094d\u091b\u093e\u0964 \u0938\u092e\u093e\u091c\u0939\u093f\u0924 \u0906\u0923\u093f \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0928\u094d\u092f\u093e\u092f\u094d\u092f \u0939\u0915\u094d\u0915\u093e\u0902\u0938\u093e\u0920\u0940 \u0924\u094d\u092f\u093e\u091a\u093e",
