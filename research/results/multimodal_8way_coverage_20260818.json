          },
          {
            "text": "\u0926\u0947\u0936\u093e\u0924\u0940\u0932 \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0902\u091a\u093e \u092c\u0941\u0932\u0902\u0926 \u0906\u0935\u093e\u091c \u092c\u0928\u0932\u0947\u0932\u093e \u0906\u092a\u0932\u094d\u092f\u093e \u092e\u0930\u093e\u0920\u0935\u093e\u0921\u094d\u092f\u093e\u091a\u093e \u0938\u0941\u092a\u0941\u0924\u094d\u0930 \u0905\u092d\u093f\u091c\u093f\u0924 \u0926\u093f\u092a\u0915\u0947",
